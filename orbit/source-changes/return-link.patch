 }
+
+/* The return route stays visible without taking space from globe controls. */
+.header-identity {
+  display: flex;
+  align-items: center;
+  gap: 24px;
+}
+.app-return-link {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  min-height: 44px;
+  padding: 4px 0;
+  color: var(--muted);
+  font-size: 12px;
+  font-weight: 500;
+  line-height: 1.4;
+  white-space: nowrap;
+  pointer-events: auto;
+}
+.app-return-link:hover {
+  color: var(--foreground);
+  text-decoration: underline;
+  text-underline-offset: 3px;
+}
+.app-return-link svg { flex-shrink: 0; }
+@media (max-width: 760px) {
+  .header-identity {
+    flex-direction: column;
+    align-items: flex-start;
+    gap: 0;
+  }
+  .ui-input,
+  .quake-browser .ui-input {
+    font-size: 16px;
+  }
+}
